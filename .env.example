# Конфигурация Docker Compose. Скопируйте в .env (или выполните scripts\init-env.ps1,
# который сгенерирует секреты автоматически). Файл .env не хранится в git.

APP_ENV=development
LOG_LEVEL=INFO

# --- Секреты (обязательны) ---
# Сгенерировать значение: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_ADMIN_PASSWORD=
DB_PASSWORD=
ANALYTICS_SERVICE_KEY=
JWT_SECRET_KEY=
DATASET_ENCRYPTION_KEY=
# Ключ шифрования резервных копий (scripts\backup.ps1). Не короче 32 символов.
BACKUP_ENCRYPTION_KEY=

# --- База данных ---
POSTGRES_ADMIN_USER=postgres
DB_NAME=crisis_analytics
DB_USER=crisis_app
# Адрес СУБД для сервера: имя контейнера или адрес другого узла
DB_HOST=database
DB_PORT=5432
# prefer — локальный HTTP-стенд. Для docker-compose.tls.yml используется verify-full.
DB_SSLMODE=prefer

# --- Адреса соседних узлов ---
ANALYTICS_SERVICE_URL=http://analytics-service:8001
BACKEND_UPSTREAM=http://backend:8000
CORS_ORIGINS=

# --- Авторизация ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# true — refresh-cookie передаётся только по HTTPS (браузеры делают исключение для localhost)
REFRESH_COOKIE_SECURE=true
# Самостоятельная регистрация аналитиков; по умолчанию пользователей создаёт администратор
ALLOW_REGISTRATION=false

# --- Публикация портов на хосте ---
# 127.0.0.1 — доступ только с этой машины; 0.0.0.0 — из сети (для размещения на разных узлах)
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PUBLISHED_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PUBLISHED_PORT=8000
ANALYTICS_BIND_ADDRESS=127.0.0.1
ANALYTICS_PUBLISHED_PORT=8001
# Используются только с docker-compose.db-port.yml
DB_BIND_ADDRESS=127.0.0.1
DB_PUBLISHED_PORT=5433
