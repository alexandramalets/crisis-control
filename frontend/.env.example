# Настройки клиента для режима разработки (npm run dev). Скопируйте в frontend/.env.

# Адрес серверного приложения, на который dev-сервер Vite проксирует /api
DEV_BACKEND_URL=http://localhost:8000
DEV_PORT=5173

# Базовый путь API в браузере. При работе через прокси (dev-сервер или nginx) оставьте /api/v1
VITE_API_BASE_URL=/api/v1
