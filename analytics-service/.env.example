# Конфигурация интеллектуального микросервиса для запуска без Docker.
# Скопируйте в analytics-service/.env. Файл .env не хранится в git.

LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001

# Межсервисный ключ, не короче 32 символов; должен совпадать со значением на сервере:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ANALYTICS_SERVICE_KEY=

# Фиксированное зерно генератора случайных чисел (воспроизводимость, REP-1)
DEFAULT_RANDOM_STATE=42

# TLS включается только вместе с файлами сертификатов (см. docs/SECURITY.md).
# REQUIRE_TLS=false
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# TLS_CA_FILE=
