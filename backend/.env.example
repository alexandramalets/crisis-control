# Конфигурация серверного приложения для запуска без Docker.
# Скопируйте в backend/.env и заполните секреты. Файл .env не хранится в git.

APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# PostgreSQL (может находиться на другом узле).
# 5433 — порт контейнера СУБД, опубликованный через docker-compose.db-port.yml;
# для СУБД, установленной в Windows, обычно 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=crisis_analytics
DB_USER=crisis_app
DB_PASSWORD=
DB_SSLMODE=prefer
DB_STARTUP_RETRIES=10
DB_STARTUP_RETRY_DELAY=2
# true — применять миграции при запуске; иначе выполните python -m app.db.setup
DB_MIGRATE_ON_STARTUP=false

# Интеллектуальный микросервис (может находиться на другом узле)
ANALYTICS_SERVICE_URL=http://localhost:8001
ANALYTICS_SERVICE_KEY=
ANALYTICS_TIMEOUT_SECONDS=30
ANALYTICS_MAX_PAYLOAD_BYTES=2097152
ANALYTICS_BREAKER_FAILURES=3
ANALYTICS_BREAKER_RESET_SECONDS=30
ANALYTICS_RETRIES=1

# Секрет подписи JWT, не короче 32 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
ALLOW_REGISTRATION=false

# Разрешённые источники CORS через запятую (при работе через прокси клиента не нужны)
CORS_ORIGINS=http://localhost:5173

# Каталог загруженных файлов и ключ AES-256-GCM исходных файлов
DATA_DIR=data
DATASET_ENCRYPTION_KEY=
UPLOAD_MAX_BYTES=10485760

# TLS включается только вместе с файлами сертификатов (см. docs/SECURITY.md).
# REQUIRE_TLS=false
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# TLS_CA_FILE=
# DB_SSLROOTCERT=
# ANALYTICS_TLS_CA_FILE=
