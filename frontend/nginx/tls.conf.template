# HTTPS-шаблон клиента. Подключается томом поверх default.conf.template
# (docker-compose.tls.yml). Порт 8080 оставлен для проверки живости и перенаправляет
# остальные запросы на HTTPS. HSTS задаётся только здесь, не в HTTP-шаблоне.
server {
    listen 8080;
    server_name _;

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"frontend"}';
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /certs/frontend.crt;
    ssl_certificate_key /certs/frontend.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:frontend:10m;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;
    client_max_body_size 10m;

    include /etc/nginx/security-headers.conf;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_ssl_name backend;
        proxy_ssl_trusted_certificate /certs/ca.crt;
        proxy_ssl_verify on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        include /etc/nginx/security-headers.conf;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    location /assets/ {
        expires 30d;
        include /etc/nginx/security-headers.conf;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri /index.html;
    }
}
